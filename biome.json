{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.turbo",
      "!**/coverage",
      "!**/research",
      "!**/.scratch"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useConst": "error",
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "node:crypto": "passmint core must not import from node:*. Use globalThis.crypto (Web Crypto).",
              "node:buffer": "passmint core must not import from node:*. Use Uint8Array.",
              "node:stream": "passmint core must not import from node:*. Use Web Streams.",
              "node:fs": "passmint core must not import from node:*. Consumers pass bytes directly.",
              "node:path": "passmint core must not import from node:*.",
              "node:util": "passmint core must not import from node:*."
            }
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "nursery": {}
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**", "**/*.test.ts", "**/scripts/**", "**/examples/**"],
      "linter": {
        "rules": {
          "nursery": {},
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
